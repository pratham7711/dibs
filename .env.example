# Twitch developer application. The authorized Twitch account is the chat bot.
TWITCH_CLIENT_ID=
TWITCH_CHANNEL=

# Optional model fallback. Without a key, ambiguous messages enter review.
GROQ_API_KEY=
DIBS_LLM_API_KEY=
DIBS_LLM_BASE_URL=https://api.groq.com/openai/v1
DIBS_LLM_MODEL=openai/gpt-oss-20b
DIBS_LLM_TOKEN_BUDGET=200000

# Optional local development overrides.
DIBS_EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws
DIBS_HELIX_URL=https://api.twitch.tv/helix
PORT=3000
